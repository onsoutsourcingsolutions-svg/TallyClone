{
  "name": "tallyclone",
  "version": "0.1.0",
  "private": true,
  "description": "TallyPrime-style accounting suite for Indian businesses — Indian GAAP / Schedule III reporting, GST, inventory. Black & gold, phone + web.",
  "type": "module",
  "scripts": {
    "dev:server": "node server/run.js",
    "dev:web": "vite",
    "dev": "concurrently -n api,web -c yellow,green \"node server/run.js\" \"vite\"",
    "build": "vite build",
    "start": "node server/run.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "multer": "^2.0.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.2",
    "vite": "^6.0.7"
  }
}
